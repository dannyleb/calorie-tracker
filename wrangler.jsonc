// Cloudflare Worker config. Secrets (API keys, passcode) are set in the
// Cloudflare dashboard under Settings -> Variables and Secrets, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calorie-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Build the app before every deploy (and before `wrangler dev`).
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker so it can add security headers.
    "run_worker_first": true
  },
  // Per-IP limit on /api requests: 30 per minute (see server/router.ts).
  "ratelimits": [{ "name": "API_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  // Keep any plain-text variables set in the dashboard (e.g. CLAUDE_MODEL) across deploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}
