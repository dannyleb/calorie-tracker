// Cloudflare Worker config. Secrets (API keys, passcode) are set in the
// Cloudflare dashboard under Settings -> Variables and Secrets, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calorie-tracker",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Build the app before every deploy (and before `wrangler dev`).
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Send API calls to the Worker instead of the static files.
    "run_worker_first": ["/api/*"]
  },
  // Keep any plain-text variables set in the dashboard (e.g. CLAUDE_MODEL) across deploys.
  "keep_vars": true,
  "observability": { "enabled": true }
}
